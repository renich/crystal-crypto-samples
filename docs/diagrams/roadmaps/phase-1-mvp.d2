direction: right

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 4
    pad: 40
    center: true
  }
}

classes: {
  milestone_container: {
    style: {
      stroke: "#059669"
      stroke-width: 2
      border-radius: 8
      fill: "#F0FDF4"
    }
  }
  task_done: {
    shape: rectangle
    style: {
      stroke: "#10B981"
      stroke-width: 2
      border-radius: 6
      fill: "#DCFCE7"
      font-color: "#064E3B"
    }
  }
}

m1_1: "Milestone 1.1: Five-Shard Demonstration Harness" {
  class: milestone_container

  t101: "TASK-101 [Done]\nCBOR FIDO & Native D-Bus Demos\nFulfills: [FUNC-001], [FUNC-004], [TECH-001]" {
    class: task_done
  }
  t102: "TASK-102 [Done]\nConstant-Time ECC & FIPS PQC Demos\nFulfills: [FUNC-002], [FUNC-003], [TECH-002]" {
    class: task_done
  }
  t103: "TASK-103 [Done]\nTPM 2.0 FIDO2 & Parameter Encryption\nFulfills: [FUNC-005], [TECH-003]" {
    class: task_done
  }
}

m1_2: "Milestone 1.2: Security Hardening, Spec Verification & Portal" {
  class: milestone_container

  t104: "TASK-104 [Done]\nSecret Redaction & Guarded Cleanup\nFulfills: [FUNC-002], [FUNC-003], [FUNC-005], [TECH-005]" {
    class: task_done
  }
  t105: "TASK-105 [Done]\nIO::Memory Spec Suite, Linters & Sphinx\nFulfills: [FUNC-001]..[FUNC-005], [TECH-004]" {
    class: task_done
  }
}

m1_1.t101 -> m1_2.t104: "Unblocks"
m1_1.t102 -> m1_2.t104: "Unblocks"
m1_1.t103 -> m1_2.t104: "Unblocks"
m1_2.t104 -> m1_2.t105: "Critical Path"
